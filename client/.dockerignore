# ==============================================================================
# Sprintly Frontend (.dockerignore)
# Purpose: Exclude unnecessary files and directories from the Docker build context.
# ==============================================================================

# Local dependencies
node_modules/
.pnpm-store/

# Local build output (Vite will build a clean bundle inside the container)
dist/

# Environment and sensitive secrets
.env
.env.*
!.env.example

# Git metadata
.git/
.gitignore

# IDE and editor settings
.vscode/
.idea/
.fleet/
.DS_Store
Thumbs.db

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
