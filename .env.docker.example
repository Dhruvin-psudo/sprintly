# ==============================================================================
# SPRINTLY DOCKER COMPOSE ENVIRONMENT VARIABLES TEMPLATE (.env.docker.example)
# ==============================================================================
# Copy this file to '.env' in the project root:
#   cp .env.docker.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PostgreSQL Database Configuration
# ------------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_password_123
POSTGRES_DB=sprintly
POSTGRES_PORT=5432

# ------------------------------------------------------------------------------
# 2. Redis Configuration
# ------------------------------------------------------------------------------
REDIS_PORT=6379

# ------------------------------------------------------------------------------
# 3. Backend (NestJS) Configuration
# ------------------------------------------------------------------------------
SERVER_PORT=3000
LOG_LEVEL=info
RUN_SEEDS=false

# Security & Authentication (Generate a strong 32+ character key for production)
JWT_SECRET=change_me_to_a_secure_random_string_at_least_32_characters
JWT_EXPIRATION=15m
REFRESH_TOKEN_EXPIRATION_DAYS=7
BCRYPT_SALT_ROUNDS=12

# ------------------------------------------------------------------------------
# 4. Frontend (Client) Configuration
# ------------------------------------------------------------------------------
CLIENT_PORT=5173
# Browser-accessible backend URL:
VITE_API_URL=http://localhost:3000/api
# Comma-separated CORS whitelist
PUBLIC_APP_URL=http://localhost:5173,http://localhost:80,http://127.0.0.1:5173
CLIENT_URL=http://localhost:5173

# ------------------------------------------------------------------------------
# 5. Email Notifications (Optional - Resend)
# ------------------------------------------------------------------------------
# RESEND_API_KEY=re_123456789
# RESEND_FROM_EMAIL="Sprintly" <notifications@yourdomain.com>
