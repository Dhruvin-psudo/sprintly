# Database Connection String
DATABASE_URL="postgresql://postgres:password@localhost:5432/sprintly"

# Server Configuration
PORT=3000
NODE_ENV=development
LOG_LEVEL=debug

# Frontend / Client App URLs & CORS Allowlist (comma-separated if multiple)
PUBLIC_APP_URL=http://localhost:5173,http://127.0.0.1:5173
CLIENT_URL=http://localhost:5173

# Redis Cache & Realtime Adapter (Optional)
REDIS_URL=redis://localhost:6379

# Authentication & Security
JWT_SECRET=replace-with-a-secure-random-secret-key-min-32-chars
JWT_EXPIRATION=15m
REFRESH_TOKEN_EXPIRATION_DAYS=7
BCRYPT_SALT_ROUNDS=12

# Email Transport - Resend (Recommended)
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM_EMAIL="Sprintly Team" <onboarding@resend.dev>

# Email Transport - Custom SMTP (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@example.com

# Email Transport - SendGrid (Legacy / Optional)
# SENDGRID_API_KEY=
# SENDGRID_FROM_EMAIL=noreply@example.com
